    "test:acceptance": "node scripts/acceptance-gate.mjs",
    "test:acceptance:evidence": "node scripts/record-acceptance-evidence.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "undici": "7.29.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
