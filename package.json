{
  "name": "crmtsiapp-local",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "bin": {
    "crm-cli": "bin/crm-cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node migrate.js",
    "worker": "node outbox-worker-main.js",
    "test": "node --test",
    "test:p1": "node test/p1-harness.mjs all",
    "test:operational": "node --test test/acceptance-gate.test.js test/acceptance-helpers.test.js",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
